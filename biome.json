{
  "$schema": "https://biomejs.dev/schemas/2.5.2/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true,
    "defaultBranch": "main"
  },
  "files": {
    "ignoreUnknown": false,
    "includes": [
      "**",
      "!**/reviews_triage",
      "!**/src/ocrs/ocrs.js",
      "!**/src/ocrs/ocrs_bg.wasm.d.ts",
      "!**/src/ocrs/ocrs.d.ts"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "attributePosition": "multiline"
  },
  "assist": { "actions": { "source": { "organizeImports": "on" } } },
  "linter": {
    "enabled": true,
    "rules": {
      "suspicious": {
        "noReactSpecificProps": "off",
        "noConsole": "off"
      },
      "complexity": {
        "noForEach": "off"
      },
      "style": {
        "noDefaultExport": "off"
      },
      "correctness": {
        "useImportExtensions": "off"
      }
    }
  },
  "javascript": {
    "formatter": {
      "semicolons": "asNeeded"
    }
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "overrides": [
    {
      "includes": ["**/src/components/**/*.tsx", "**/src/app/layout.tsx"],
      "linter": {
        "rules": {
          "correctness": {
            "noUndeclaredVariables": "off"
          },
          "style": {},
          "performance": {
            "noNamespaceImport": "off"
          }
        }
      }
    }
  ]
}
